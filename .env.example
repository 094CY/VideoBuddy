# VideoBuddy 环境变量示例
# 复制为 .env 后按需修改。全部留空也能本地启动。

# 后端监听地址与端口。默认只监听 127.0.0.1；容器内需设为 0.0.0.0
HOST=127.0.0.1
PORT=3721

# 运维额外放行的代理域名（逗号分隔）。
# 用户在「设置 → 模型 & Key」添加服务时会自动注册该地址，通常无需在此配置。
# 目标必须为 HTTPS 且解析到公网地址。
PROXY_ALLOWED_HOSTS=

# 跨域允许的来源（逗号分隔，精确匹配）。留空表示同源，不发送 CORS 头。
# 开发模式由 Vite 转发 /api/*，天然同源，无需配置。
CORS_ALLOW_ORIGIN=

# 代理请求超时（毫秒）与响应体上限（字节）
PROXY_TIMEOUT_MS=120000
MAX_RESPONSE_BYTES=33554432

# 存储后端：file（默认）或 sqlite（Node 内置数据库，支持多进程共享）
# 账号、会话、租户工作区与托管模型配置都存放在这一后端
VB_STORAGE_BACKEND=
# SQLite 数据库路径；设置后也可用作 SQLite 后端的库文件位置
DATABASE_URL=
# 服务端多租户数据目录（file 后端使用）
VB_DATA_DIR=

# 首次启动创建的管理员账号。账号是通用标识，邮箱、手机号、用户名、姓名均可。
# 本地开发留空即可：使用内置默认账号与口令，启动时会在日志中打印。
# 生产部署必须在此显式设置账号与口令，否则服务拒绝启动。
VB_ADMIN_ACCOUNT=
VB_ADMIN_PASSWORD=

# 自动备份间隔（小时），0 表示关闭；默认 24，保留最近 7 份
VB_BACKUP_INTERVAL_HOURS=24

# 单账号每分钟允许的最大 AI 代理请求数
VB_PROXY_QUOTA_PER_MIN=120

# HTTPS 部署时设为 1，让会话 Cookie 带上 Secure 标记
VB_SECURE_COOKIE=0

# AI API Key 不在这里配置。请在应用内「设置 → 模型 & Key」填写。

# 可选：固定本地开发模式的管理员口令。留空则每次启动随机生成并在日志打印。
# 生产部署不使用此项，必须设置 VB_ADMIN_PASSWORD。
VB_DEV_PASSWORD=
